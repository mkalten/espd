# ESP32-S3 — chip-wide tuning (no board pre-select; pick board in menuconfig or
# sdkconfig.defaults.local). Board YAML overrides flash/partitions (e.g. 16 MB).

# Generic / CI smoke defaults (resizes dynamically to physical flash size at boot)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_pd_4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_pd_4mb.csv"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Audio loop on CPU1; USB/WiFi/pthread workers on CPU0 (see main/espd.c, espd_dev.c).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_AFFINITY="0x1"
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY="0x0"
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=5
CONFIG_PTHREAD_TASK_CORE_DEFAULT=0

# Wear levelling + TinyUSB MSC (when enabled): WL uses 4096-byte sectors.
# NOTE: FATFS sector size must remain 512 for SD card compatibility (SD physical
# sectors are always 512 bytes; FATFS_SECTOR_4096 causes mount to fail).
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_FATFS_SECTOR_512=y

# ESP32-S3 CPU Frequency (240 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Wi-Fi throughput and buffer optimization
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Networking limits
CONFIG_LWIP_MAX_SOCKETS=8

# PSRAM (SPIRAM) physical layout and speed defaults for ESP32-S3
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_REV_MIN_2=y
CONFIG_ESP32S3_REV_MIN_FULL=2
CONFIG_ESP_REV_MIN_FULL=2

# PSRAM (SPIRAM) optimal memory allocation defaults
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

# USB OTG, MSC, and CDC sync defaults for ESP32-S3
CONFIG_ESPD_USE_USB_OTG=y
CONFIG_ESPD_USE_USB_MSC=y
CONFIG_ESPD_DEV_SYNC=y
CONFIG_ESPD_DEV_CDC_SYNC=y
